# Скопируй в .env и заполни. В git .env не попадает.
TOKEN=123456:AA-your-token-here
ADMIN_ID=123456789
# Супергруппа для алертов мониторинга (бот должен быть участником). 0 = не слать.
ALERT_CHAT_ID=-1001234567890
# id темы (topic) внутри супергруппы. 0 = слать без темы (General).
# Узнать оба числа: написать /id прямо в нужной теме.
ALERT_THREAD_ID=0
# Прокси ТОЛЬКО для связи бота с Telegram. На ping не влияет. Пусто = без прокси.
# Кавычки не нужны (бот их снимает сам, но лучше без них).
PROXY_URL=
DATA_DIR=data
# Сеть прокси участников (/get_proxy)
PROXY_PORT=1080
PROXY_CHECK_INTERVAL=60
PROXY_WAIT_HOURS=24
PING_LIMIT=32
# Сколько адресов можно проверить за один скан (4 сети /24)
SCAN_MAX_IPS=1024
CHECK_INTERVAL=3600
MAX_WATCH=20
